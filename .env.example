# Cau hinh Database (De trong hoac dung SQLite cho local dev; Dien chuoi Supabase Supavisor cong 6543 khi deploy)
DATABASE_URL=sqlite:///./orders.db
# Vi du chuoi Supabase Supavisor:
# DATABASE_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Xac thuc API Key bao mat (Tieu chi Y4)
API_KEY=asm-api-secret-key-2026
REQUIRE_API_KEY=false

# Cau hinh Google AI Studio (Gemini Flash Lite)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite

# Cau hinh OpenAI (Neu muon dung OpenAI thay vi Gemini)
OPENAI_API_KEY=
